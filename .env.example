NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# Nur serverseitig fuer die oeffentliche Teilen-Route (/teilen/[token]),
# niemals an den Client senden. Siehe docs/database-schema.md Abschnitt 3.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=erinnerung@mail.gift-wise.de
# Taeglicher Zeitplaner (#83): beliebiger zufaelliger Wert, in Vercel als
# Umgebungsvariable hinterlegen. Vercel Cron schickt ihn automatisch als
# "Authorization: Bearer <CRON_SECRET>" mit, siehe vercel.json und
# src/app/api/cron/daily/route.ts.
CRON_SECRET=
